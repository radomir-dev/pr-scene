{
  "name": "pr-scene",
  "version": "1.1.1",
  "description": "Render GitHub pull request scenes from fixtures for demos, docs and screenshots",
  "keywords": [
    "demo",
    "fixtures",
    "github",
    "markdown",
    "mock",
    "pull-request",
    "screenshot"
  ],
  "homepage": "https://radomir.dev/pr-scene/",
  "bugs": {
    "url": "https://github.com/radomir-dev/pr-scene/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/radomir-dev/pr-scene.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json",
    "./scene.schema.json": "./dist/scene.schema.json"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.build.json && node scripts/build-css.mjs && node scripts/build-schema.mjs && node scripts/fix-esm.mjs",
    "build:demo": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project=unit",
    "test:coverage": "vitest run --project=unit --coverage",
    "doctor": "node scripts/doctor.ts",
    "lint": "oxlint src demo test scripts commitlint.config.js vite.config.ts vitest.config.ts",
    "format": "oxfmt src demo test/*.ts scripts vite.config.ts vitest.config.ts package.json tsconfig.json tsconfig.build.json .oxlintrc.json .oxfmtrc.json commitlint.config.js lefthook.yml .github/workflows/ci.yml",
    "format:check": "oxfmt --check src demo test/*.ts scripts vite.config.ts vitest.config.ts package.json tsconfig.json tsconfig.build.json .oxlintrc.json .oxfmtrc.json commitlint.config.js lefthook.yml .github/workflows/ci.yml",
    "check": "npm run lint && npm run format:check",
    "prepare": "lefthook install",
    "icons": "node scripts/generate-icons.mjs",
    "fixtures:markdown": "node scripts/markdown-fixtures.mjs",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots",
    "shots": "playwright test --config playwright.shots.config.ts",
    "docs": "node scripts/docs.mjs",
    "docs:check": "node scripts/docs.mjs --check",
    "storybook": "storybook dev -p 6006",
    "build:storybook": "storybook build -o storybook-static",
    "test:stories": "vitest run --project=storybook",
    "check:package": "publint --strict && attw --pack . --ignore-rules cjs-resolves-to-esm no-resolution && node scripts/check-pack.mjs",
    "check:size": "size-limit",
    "check:unused": "knip",
    "check:deps": "depcruise src --config .dependency-cruiser.cjs",
    "check:actions": "node scripts/actionlint.mjs"
  },
  "dependencies": {
    "dompurify": "^3.5.0",
    "marked": "^18.3.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@playwright/test": "^1.65.1",
    "@primer/css": "^22.3.3",
    "@primer/octicons": "^19.43.0",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.11",
    "@semantic-release/npm": "^13.2.0",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@size-limit/file": "^14.3.0",
    "@storybook/addon-a11y": "^10.6.9",
    "@storybook/addon-docs": "^10.6.9",
    "@storybook/addon-vitest": "^10.6.9",
    "@storybook/html-vite": "^10.6.9",
    "@types/node": "^22.0.0",
    "@vitest/browser": "^5.1.2",
    "@vitest/browser-playwright": "^5.1.2",
    "@vitest/coverage-v8": "^5.1.2",
    "dependency-cruiser": "^18.9.0",
    "eslint": "^10.15.0",
    "eslint-plugin-sonarjs": "^4.2.3",
    "fast-check": "^4.11.0",
    "jsdom": "^31.0.1",
    "knip": "^6.48.0",
    "lefthook": "^2.2.4",
    "lint-staged": "^17.6.2",
    "listr2": "^11.4.1",
    "oxfmt": "0.80.0",
    "oxlint": "^1.95.0",
    "publint": "^0.3.25",
    "semantic-release": "^25.0.9",
    "size-limit": "^14.3.0",
    "storybook": "^10.6.9",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.14.1",
    "typescript": "^5.9.0",
    "vite": "^8.4.0",
    "vitest": "^5.1.2"
  },
  "lint-staged": {
    "**/*.{ts,tsx,js,mjs,cjs}": [
      "oxlint --fix",
      "oxfmt"
    ],
    "src/**/!(*.d).ts": [
      "vitest related --run --passWithNoTests=false"
    ],
    "*.{json,yml,yaml,md,css,html}": [
      "oxfmt"
    ],
    "{src,demo,test,scripts}/**/*.{json,yml,yaml,md,css,html}": [
      "oxfmt"
    ]
  },
  "size-limit": [
    {
      "name": "library entry",
      "path": "dist/index.js",
      "limit": "10 kB"
    },
    {
      "name": "stylesheet",
      "path": "dist/styles.css",
      "limit": "25 kB"
    }
  ],
  "engines": {
    "node": ">=22"
  }
}
